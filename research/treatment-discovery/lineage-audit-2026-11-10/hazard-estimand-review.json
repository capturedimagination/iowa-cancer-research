  "primary_source_facts": {
    "source": "oren2021_author_manuscript",
    "location": "Methods pp9-10; Fig1; source dictionary also reads Extended Data Fig1b.",
    "summary": "Nonpersisters use forward random-sister tracking. Persister founders are identified from endpoint cells and then one forward path retained. Exact selected-path/entry rules needed for hazard inference remain unresolved."
  },
  "estimand_definition": {
    "risk": "Y_i(t)=1 if the current tracked cell is alive, observed and eligible. Division resets to the selected daughter; death ends the path.",
    "rates": "D_B / sum_i integral_B Y_i(t)dt; M_B / sum_i integral_B Y_i(t)dt.",
    "constant_hazard_likelihood": "lambda^D mu^M exp[-(lambda+mu)A], for exact events and a valid observation scheme.",
    "cycle_clock": "Cell age and calendar time since drug exposure differ. Unknown initial birth time cannot be replaced by movie start.",
    "censoring": "Administrative end, tracking loss and missing annotation must be distinct from death. A competing-risk division probability is not naive 1-minus-KM with death censored.",
    "population_weighting": "Only under verified prospective founder sampling and independent half-probability sister choices, generation-g contributions weighted by 2^g yield full-tree totals in expectation. Include founder sampling weights. This is not certified for the workbook."
  },
  "analytic_model": {
    "type": "Homogeneous binary branching birth/death with a random daughter tag and independent identical cells.",
    "parameters": "lambda: division; mu: death; T: endpoint; arbitrary time units.",
    "q": "mu*(1-exp(-(lambda-mu)*s))/(lambda-mu*exp(-(lambda-mu)*s)); criticalk*s/(1+k*s).",
    "A": "exp(lambda*integral_0^t(q(T-u)-1)du).",
    "joint_risk_R": "exp(-mu*t)*(1-q(T-t)*A(t)).",
    "family_selection_probability": "1-q(T).",
    "selected_division_hazard": "lambda*(1-q(T-t)^2*A)/(1-q(T-t)*A).",
    "selected_death_hazard": "mu*(1-A)/(1-q(T-t)*A).",
    "selected_tag_survival": "[lambda*exp(-mu*t)-mu*exp(-lambda*t)]/(lambda-mu); criticalexp(-k*t)*(1+k*t).",
    "risk_conservation": "Rprime=-mu*exp(-mu*t)*(1-A).",
    "critical_death_hazard": "k^2*t/(1+k*t).",
    "endpoint_death_limit": "mu*(1-A(T)), not generally mu.",
    "limitations": [
      "Inherited frailty or correlated/asymmetric daughter fates",
      "Time-, age- or density-dependent biology",
      "Informative observation loss",
      "Nonrandom daughter choice",
      "Unknown outcome ascertainment"
    ],
    "not_an_Oren_model_claim": true
  },
