  "minimum_gate": [
    {
      "id": "cohort",
      "required": "Day-0 founder roster, enrollment/exclusions, inclusion probabilities, row duplicates, endpoint ascertainment and branch-choice rule."
    },
    {
      "id": "dictionary",
      "required": "Named row identity and cross-sheet join; event/cumulative/zero/missing definitions; actual timestamp map and exposure history."
    },
    {
      "id": "risk_censoring",
      "required": "Birth or entry clock, alive/observed mask, loss versus death/administrative end, lineage/independent-experiment IDs; retain nondividers."
    },
    {
      "id": "frozen_analysis",
      "required": "Choose path/family/population estimand, denominator, justified weights, dependence model and observation likelihood before fitting; pass analytic selection controls."
    },
    {
      "id": "stop_rule",
      "required": "Unverified selection/time/censoring means no empirical hazard estimate. Functional-state exit needs observed transitions and state-risk exposure separately."
    }
  ],
